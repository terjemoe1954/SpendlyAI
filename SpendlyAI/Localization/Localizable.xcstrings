    "help.dailyBudget.formula.body" : {
      "comment" : "Body text for the daily budget formula section in the help guide.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "SpendlyAI subtracts fixed expenses due before your next income, planned savings due in the same period, and your minimum buffer from your available money. The remainder is divided by the number of days until the next income date."
          }
        },
        "nb" : {
          "stringUnit" : {
