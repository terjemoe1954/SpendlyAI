    "ai.fallback.noBudget" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set up your financial profile first, then I can explain your budget numbers."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sett opp økonomiprofilen først, så kan jeg forklare budsjettallene dine."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตั้งค่าโปรไฟล์การเงินก่อน แล้วฉันจะช่วยอธิบายตัวเลขงบประมาณของคุณได้"
          }
        }
      }
    },
    "ai.fallback.notice" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Using a local fallback because AI access is unavailable."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruker lokal reservetekst fordi AI-tilgang ikke er tilgjengelig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กำลังใช้ข้อความสำรองในเครื่องเพราะยังไม่มีการเข้าถึง AI"
          }
        }
      }
    },
    "ai.fallback.overspent" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have spent more than today’s safe amount. Keeping the rest of today quiet can limit the impact on the remaining period. This is budgeting guidance, not professional financial advice."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har brukt mer enn dagens trygge beløp. Holder du resten av dagen rolig, kan du begrense effekten på resten av perioden. Dette er budsjettveiledning, ikke profesjonell finansiell rådgivning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณใช้เกินยอดที่ปลอดภัยสำหรับวันนี้แล้ว การใช้ให้น้อยลงในช่วงที่เหลือของวันจะช่วยลดผลกระทบต่อช่วงเวลาที่เหลือ นี่คือคำแนะนำด้านงบประมาณ ไม่ใช่คำปรึกษาทางการเงินจากผู้เชี่ยวชาญ"
          }
        }
      }
    },
    "ai.fallback.pressured" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your budget is under pressure. Prioritizing necessary purchases can help protect your buffer until the next income date. This is budgeting guidance, not professional financial advice."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Budsjettet ditt er presset. Prioriterer du nødvendige kjøp, kan du beskytte bufferen frem til neste inntekt. Dette er budsjettveiledning, ikke profesjonell finansiell rådgivning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "งบประมาณของคุณค่อนข้างตึง การให้ความสำคัญกับรายการที่จำเป็นจะช่วยรักษาเงินสำรองจนถึงรายได้ครั้งถัดไป นี่คือคำแนะนำด้านงบประมาณ ไม่ใช่คำปรึกษาทางการเงินจากผู้เชี่ยวชาญ"
          }
        }
      }
    },
    "ai.fallback.steady" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You still have room today. Staying near the safe daily amount keeps the rest of the period steadier. This is budgeting guidance, not professional financial advice."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har fortsatt handlingsrom i dag. Holder du deg nær det trygge dagsbeløpet, blir resten av perioden jevnere. Dette er budsjettveiledning, ikke profesjonell finansiell rådgivning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วันนี้คุณยังมีเงินใช้ได้ การใช้ใกล้เคียงยอดรายวันที่ปลอดภัยจะช่วยให้ช่วงเวลาที่เหลือสมดุลขึ้น นี่คือคำแนะนำด้านงบประมาณ ไม่ใช่คำปรึกษาทางการเงินจากผู้เชี่ยวชาญ"
          }
        }
      }
    },
    "ai.privacy.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spendly AI sends only a compact budget summary and your question to a secure backend when AI access is configured. It does not send your full transaction history."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spendly AI sender bare en kompakt budsjettoppsummering og spørsmålet ditt til en sikker backend når AI-tilgang er konfigurert. Hele transaksjonshistorikken sendes ikke."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อมีการตั้งค่าการเข้าถึง AI แล้ว Spendly AI จะส่งเฉพาะสรุปงบประมาณแบบย่อและคำถามของคุณไปยังแบ็กเอนด์ที่ปลอดภัย โดยไม่ส่งประวัติธุรกรรมทั้งหมด"
          }
        }
      }
    },
