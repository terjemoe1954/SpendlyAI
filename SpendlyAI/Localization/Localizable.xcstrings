    "help.backup.safety.body" : {
      "comment" : "Answer to the FAQ question about the safety of backing up.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Restoring replaces the current profile, transactions, fixed expenses, and savings goals only after you confirm. Invalid files do not change existing data."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gjenoppretting erstatter gjeldende profil, transaksjoner, faste utgifter og sparemål først etter at du har bekreftet. Ugyldige filer endrer ikke eksisterende data."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ระบบจะแทนที่โปรไฟล์ ธุรกรรม ค่าใช้จ่ายประจำ และเป้าหมายการออมปัจจุบันเมื่อคุณยืนยันแล้วเท่านั้น ไฟล์ที่ไม่ถูกต้องจะไม่เปลี่ยนแปลงข้อมูลที่มีอยู่"
          }
        }
      }
