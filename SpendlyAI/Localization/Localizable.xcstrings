    "dailyInsight.flexible" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have %@ available today. Staying under %@ keeps about %@ extra room for later."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har %@ tilgjengelig i dag. Holder du deg under %@, beholder du omtrent %@ ekstra handlingsrom til senere."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วันนี้คุณมี %@ ที่ใช้ได้ หากใช้ไม่เกิน %@ จะเหลือพื้นที่ประมาณ %@ สำหรับภายหลัง"
          }
        }
      }
    },
    "dailyInsight.lowRemaining" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have %@ left today. Choosing the most useful next purchase helps keep tomorrow steady."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har %@ igjen i dag. Velger du det mest nyttige neste kjøpet, holder du morgendagen mer stabil."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วันนี้คุณเหลือ %@ การเลือกซื้อสิ่งที่มีประโยชน์ที่สุดถัดไปจะช่วยให้พรุ่งนี้มั่นคงขึ้น"
          }
        }
      }
    },
    "dailyInsight.nearIncome" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have %@ available today with %d days until next income. Staying near that amount keeps the landing smoother."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har %@ tilgjengelig i dag med %d dager til neste inntekt. Holder du deg nær det beløpet, blir overgangen jevnere."
